#!/usr/bin/env bash
#
#
set -oue pipefail

if [[ -z "$EDITOR" ]]; then
  EDITOR="vi"
fi

# bash wizardry that basically just sets the delimeter to underscore to make my life not living regex hell :), ik it's probably infinitely borked but idgaf
IFS="_"; name="$*"; unset IFS

if [[ ! -z "$name" ]]; then
  printf -v OLD_FILE '%s/journal/math/%s/note.typst' "$HOME" "$name"
  printf -v FILE '%s/journal/math/%s/note.typ' "$HOME" "$name"
else

  printf -v OLD_FILE '%s/%(journal/math/%Y/%m/%d/note.typst)T' "$HOME"
  printf -v FILE '%s/%(journal/math/%Y/%m/%d/note.typ)T' "$HOME"
fi

if [[ -e "$OLD_FILE" ]]; then
    mv "$OLD_FILE" "$FILE"
fi

# cdeez nuts
# cd "$(dirname "$FILE")"
$EDITOR "$FILE"
